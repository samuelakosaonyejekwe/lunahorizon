{
  "name": "LunaHorizon: Lunar Mission Browser",
  "short_name": "LunaHorizon",
  "description": "Compare lunar landing sites and dates: Sun and Earth over real terrain horizons, solar power and direct-to-Earth windows.",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b1020",
